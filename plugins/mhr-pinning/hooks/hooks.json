{
  "description": "Dependency and GitHub Actions pinning guards for Write/Edit/MultiEdit.",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Write|Edit|MultiEdit",
        "hooks": [
          { "type": "command", "command": "bash \"${CLAUDE_PLUGIN_ROOT}/hooks/no-version-ranges.sh\"" },
          { "type": "command", "command": "bash \"${CLAUDE_PLUGIN_ROOT}/hooks/no-unpinned-actions.sh\"" }
        ]
      }
    ]
  }
}
